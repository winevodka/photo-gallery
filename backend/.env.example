# Server
PORT=3001

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://gallery:gallery@localhost:5432/gallery
# Set to "true" when using a cloud Postgres that requires SSL (Neon, Supabase, etc.)
DATABASE_SSL=false

# Google Drive API
# Path to a service account JSON key with read access to the shared Drive folders (local dev)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
# Or paste the full JSON key content as a single-line string (recommended for
# cloud hosts like Railway/Render/Vercel where uploading a file isn't possible).
# If set, this takes priority over GOOGLE_SERVICE_ACCOUNT_KEY_PATH.
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# CORS: comma-separated list of allowed frontend origins in production
# CORS_ORIGIN=https://your-app.vercel.app

# Admin API key required (header "x-admin-key") for write endpoints:
# POST /albums, POST /albums/:id/sync, DELETE /albums/:id
# Generate a random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-random-secret
